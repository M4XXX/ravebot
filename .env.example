# RaveBot — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==============================================================================
# REQUIRED — bot will exit with a descriptive error if any of these are missing
# ==============================================================================

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
# Docker Compose local dev default: postgresql://ravebot:ravebot@localhost:5432/ravebot
POSTGRES_URL=postgresql://ravebot:ravebot@localhost:5432/ravebot

# Internal Integration Secret of your Notion integration
# Create at: https://www.notion.so/my-integrations (capabilities: read, insert, update content)
NOTION_API_KEY=your_notion_integration_secret

# 32-character ID of an empty Notion page shared with the integration
# (page menu > Connections); the bot creates its Events, Slots and DJs databases under it.
# Find it at the end of the page URL: notion.so/{workspace}/{Title}-{PAGE_ID}
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id_here

# Comma-separated Discord user IDs allowed to use all admin slash commands
# Find a user ID: Discord → User Profile → Copy User ID (developer mode required)
# Example: ADMIN_USER_IDS=123456789012345678,987654321098765432
ADMIN_USER_IDS=

# ==============================================================================
# OPTIONAL — safe defaults provided; override as needed
# ==============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO

# asyncpg connection pool size  (defaults: min=5, max=20)
DB_POOL_MIN=5
DB_POOL_MAX=20
