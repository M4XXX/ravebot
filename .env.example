# RaveBot — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==============================================================================
# REQUIRED — bot will exit with a descriptive error if any of these are missing
# ==============================================================================

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
# Docker Compose local dev default: postgresql://ravebot:ravebot@localhost:5432/ravebot
POSTGRES_URL=postgresql://ravebot:ravebot@localhost:5432/ravebot

# Notion integration API key (starts with "secret_")
# Create at: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_integration_key

# Notion database ID containing the event/slot schedule
# Find it in the Notion database URL: notion.so/{workspace}/{DATABASE_ID}?v=...
# The ID is the 32-character hex string before the "?v=" query parameter
NOTION_DATABASE_ID=your_notion_database_id_here

# Comma-separated Discord user IDs allowed to use all admin slash commands
# Find a user ID: Discord → User Profile → Copy User ID (developer mode required)
# Example: ADMIN_USER_IDS=123456789012345678,987654321098765432
ADMIN_USER_IDS=

# ==============================================================================
# OPTIONAL — safe defaults provided; override as needed
# ==============================================================================

# Discord server ID the bot serves. Without it the bot serves the single server it is in,
# and none (with an error in the log) when it is in several. Recommended in production.
GUILD_ID=

# Notion layout: "classic" (the bot's own database, docs/user-guide.md 2.4) or "tds"
# (an existing event plan with one text column per hour slot, docs/user-guide.md 2.6)
NOTION_LAYOUT=classic

# Comma-separated status names DJs may book in (tds layout). Empty: every event is bookable.
# Example: NOTION_BOOKABLE_STATUSES=Planing-stage,Not started,Requires Host
NOTION_BOOKABLE_STATUSES=

# Log level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO

# asyncpg connection pool size  (defaults: min=5, max=20)
DB_POOL_MIN=5
DB_POOL_MAX=20
