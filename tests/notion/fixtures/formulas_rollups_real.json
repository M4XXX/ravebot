    }
   },
   "Time": {
    "formula": {
     "expression": "lets(m, mod(toNumber(prop(\"Event start\").substring(0, 2)) * 60 + toNumber(prop(\"Event start\").substring(3, 5)) + (prop(\"Slot number\") - 1) * prop(\"Event slot length\"), 1440), format(floor(m / 60)).padStart(2, \"0\") + \":\" + format(m % 60).padStart(2, \"0\"))"
    }
   },
   "Slot status": {
    "formula": {
     "expression": "if(empty(prop(\"DJ\")), \"Open\", \"Booked\")"
    }
   }
  }
 },
